# ============================
# Makefile for PureMCMF project
# ============================

CXX := g++
CXXFLAGS := -O2 -std=c++17 -Wall -Wextra -Wshadow -Wconversion
# 使用当前 conda 环境
CONDA_PREFIX ?= $(shell echo $$CONDA_PREFIX)
LEMON_PREFIX ?= $(CONDA_PREFIX)
INCLUDES := -I$(LEMON_PREFIX)/include
LDFLAGS := -L$(LEMON_PREFIX)/lib -lemon

# 目录结构
SRC_DIR := src
BUILD_DIR := build
TARGET := pure_mcmf

# 源文件
SRCS := $(SRC_DIR)/PureMcmfColumnPlacer.cpp $(SRC_DIR)/main.cpp
OBJS := $(SRCS:%.cpp=$(BUILD_DIR)/%.o)
BIN := $(BUILD_DIR)/$(TARGET)

# 默认规则
.PHONY: all clean run envcheck

all: envcheck $(BIN)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)
	mkdir -p $(BUILD_DIR)/$(SRC_DIR)

$(BUILD_DIR)/%.o: %.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@

$(BIN): $(OBJS)
	$(CXX) $(CXXFLAGS) $^ $(LDFLAGS) -o $@
	@echo "✅ Build complete: $(BIN)"

# 运行验证（3×3、4×4、8×8）
run: all
	$(BIN)

# 环境检查
envcheck:
	@if [ -z "$(CONDA_PREFIX)" ]; then \
		echo "⚠️  Not inside conda environment. Run: conda activate rsad_mcmf"; \
	else \
		echo "✅ Conda env: $(CONDA_PREFIX)"; \
	fi
	@if pkg-config --exists lemon; then \
		echo "✅ LEMON found via pkg-config"; \
	else \
		echo "⚠️  LEMON not found by pkg-config. If build fails, run: conda install -c conda-forge lemon"; \
	fi

# 清理
clean:
	rm -rf $(BUILD_DIR)
